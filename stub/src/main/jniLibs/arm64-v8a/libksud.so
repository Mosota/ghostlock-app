#!/system/bin/sh
# 被 GhostLock 以 root 身份 exec（GHOSTLOCK_KSUD 指向本文件）
LOG=/data/local/tmp/ksud-hook.log
{
  echo "== $(date '+%F %T') uid=$(id -u) args=$*"
  if [ -f /data/local/tmp/ksud-hook.sh ]; then
    /system/bin/sh /data/local/tmp/ksud-hook.sh "$@"
  else
    echo "no /data/local/tmp/ksud-hook.sh"
  fi
} >> "$LOG" 2>&1
