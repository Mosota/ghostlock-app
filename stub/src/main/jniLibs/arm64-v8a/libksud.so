#!/system/bin/sh
# GhostLock 以 root 身份 exec 本文件（GHOSTLOCK_KSUD）
LOG1=/sdcard/Download/DSH-Go/ksud-hook.log
LOG2=/data/local/tmp/ksud-hook.log
run() {
  echo "== $(date '+%F %T') uid=$(id -u) args=$*"
  for H in /sdcard/Download/DSH-Go/ksud-hook.sh /data/local/tmp/ksud-hook.sh; do
    if [ -f "$H" ]; then echo "hook: $H"; /system/bin/sh "$H" "$@"; return; fi
  done
  echo "no hook script found"
}
run "$@" >> "$LOG1" 2>&1
run "$@" >> "$LOG2" 2>&1
